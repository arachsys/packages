require go

check() {
  url https://github.com/filosottile/age/tags
  match version 1.3.2 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack age-1.3.2.tar.gz \
    https://github.com/filosottile/age/archive/refs/tags/v1.3.2.tar.gz
  go mod vendor
  tree 9b4b3b7b7fc7a769ca42a75f8b912e5de726a9c398727ecd927a4b1c687c1d75
}

build() {
  go build -C cmd/age
  go build -C cmd/age-keygen
  install -t /dst/bin -D cmd/age/age cmd/age-keygen/age-keygen
}
