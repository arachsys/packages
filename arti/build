require rust sqlite

check() {
  url https://index.crates.io/ar/ti/arti
  match version 2.8.0 '"name":\s*"arti",\s*"vers":\s*"([0-9.]+)"'
}

prepare() {
  unpack arti-2.8.0.tar.gz \
    https://crates.io/api/v1/crates/arti/2.8.0/download
  mkdir -p .cargo && cargo vendor --locked >>.cargo/config.toml
  apply cosmetic.diff
  apply features.diff
  apply paths.diff
  tree 36a45bf02494448e5fce9626430a3ca5cecdf46fe7398f06de74e61fffb4917d
}

build() {
  cargo build -p arti --release
  install -t /dst/bin -D target/release/arti
  image - requires sqlite
}
