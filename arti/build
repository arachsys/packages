require rust sqlite

check() {
  url https://index.crates.io/ar/ti/arti
  match version 2.7.0 '"name":\s*"arti",\s*"vers":\s*"([0-9.]+)"'
}

prepare() {
  unpack arti-2.7.0.tar.gz \
    https://crates.io/api/v1/crates/arti/2.7.0/download
  mkdir -p .cargo && cargo vendor --locked >>.cargo/config.toml
  apply cosmetic.diff
  apply features.diff
  apply paths.diff
  tree 36922b4178412082aa2caea78beb543147768cd8080156d15725426247feeb5e
}

build() {
  cargo build -p arti --release
  install -t /dst/bin -D target/release/arti
  image - requires sqlite
}
