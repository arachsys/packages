require rust sqlite

check() {
  url https://index.crates.io/ar/ti/arti
  match version 2.6.0 '"name":\s*"arti",\s*"vers":\s*"([0-9.]+)"'
}

prepare() {
  unpack arti-2.6.0.tar.gz \
    https://crates.io/api/v1/crates/arti/2.6.0/download
  mkdir -p .cargo && cargo vendor --locked >>.cargo/config.toml
  apply cosmetic.diff
  apply features.diff
  apply paths.diff
  tree 3ab9d3cb2173a9e66dc1c0deb20eeac3df36b509a4cbce158510794c4cc68b8f
}

build() {
  cargo build -p arti --release
  install -t /dst/bin -D target/release/arti
  image - requires sqlite
}
