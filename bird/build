require bison flex

check() {
  url https://bird.nic.cz/get-bird/
  match version 2.20.0 'bird-(2\.[0-9.]+)\.tar'
}

prepare() {
  unpack https://bird.nic.cz/download/bird-2.20.0.tar.gz
  apply history.diff
  tree 711b86581d1e1bf951a58a9766ade6cded98c06537fa1c5c3314963c52aca256
}

build() {
  auto-config
  make install DESTDIR=/dst
}
