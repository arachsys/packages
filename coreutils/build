check() {
  url https://{,mirrorservice.org/sites/}ftp.gnu.org/gnu/coreutils/
  match version 9.12 'coreutils-([0-9.]+)\.tar'
}

prepare() {
  unpack https://ftp.gnu.org/gnu/coreutils/coreutils-9.12.tar.xz
  apply fmt.diff
  tree db974cae91157b184f3a0ded0c169f5cfa54fdd91cd018126666db45dfee2a91
}

build() {
  FORCE_UNSAFE_CONFIGURE=1 auto-config --enable-install-program=hostname \
    --enable-no-install-program=hostid,kill,pinky,uptime,users,who \
    --disable-manual-url
  make install DESTDIR=/dst
}
