require sqlite

check() {
  url https://downloads.exim.org/exim4/
  match version 4.100.2 'exim-([0-9.]+)\.tar'
}

prepare() {
  unpack https://downloads.exim.org/exim4/exim-4.100.2.tar.xz
  apply config.diff
  apply exepath.diff
  apply libressl.diff
  apply logs.diff
  apply lsearch.diff
  apply modesty.diff
  apply paths.diff
  apply uidgid.diff
  tree 1f0fbefce03de68138c04ae48ce78f1dddc1fedbb6bfc2cf292031a14e76770c
}

build() {
  make makefile
  make -C build-* exim PREFIX=
  install -s -t /dst/bin -D build-*/exim
  image - requires sqlite
}
