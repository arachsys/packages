require sqlite

check() {
  url https://downloads.exim.org/exim4/
  match version 4.100.1 'exim-([0-9.]+)\.tar'
}

prepare() {
  unpack https://downloads.exim.org/exim4/exim-4.100.1.tar.xz
  apply config.diff
  apply exepath.diff
  apply libressl.diff
  apply logs.diff
  apply lsearch.diff
  apply modesty.diff
  apply paths.diff
  apply uidgid.diff
  tree 1511abcb8348aeca1238fc5e4393020e99659ea6c9399b8a7b790bb6c02af73b
}

build() {
  make makefile
  make -C build-* exim PREFIX=
  install -s -t /dst/bin -D build-*/exim
  image - requires sqlite
}
