check() {
  url https://github.com/libexpat/libexpat/tags
  match version 2.9.0 'tags/R_([0-9]+)_([0-9]+)_([0-9]+)\.tar' '\1.\2.\3'
}

prepare() {
  unpack https://github.com/libexpat/libexpat/releases/download/R_2_9_0/expat-2.9.0.tar.xz
  tree f883986fde1993483d4501607162bbcdb5f1eaa1da9fab97bc8f4fc4801d3745
}

build() {
  auto-config LDFLAGS=-Wl,--as-needed,-lunwind
  make install DESTDIR=/dst
  rm -f -r /dst/lib/cmake
}
