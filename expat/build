check() {
  url https://github.com/libexpat/libexpat/tags
  match version 2.8.4 'tags/R_([0-9]+)_([0-9]+)_([0-9]+)\.tar' '\1.\2.\3'
}

prepare() {
  unpack https://github.com/libexpat/libexpat/releases/download/R_2_8_4/expat-2.8.4.tar.xz
  tree 4797a186b2300d252be58b7267f01397ad62947c70d08a74b3ed1048ab3c3e72
}

build() {
  auto-config LDFLAGS=-Wl,--as-needed,-lunwind
  make install DESTDIR=/dst
  rm -f -r /dst/lib/cmake
}
