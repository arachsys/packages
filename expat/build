check() {
  url https://github.com/libexpat/libexpat/tags
  match version 2.8.3 'tags/R_([0-9]+)_([0-9]+)_([0-9]+)\.tar' '\1.\2.\3'
}

prepare() {
  unpack https://github.com/libexpat/libexpat/releases/download/R_2_8_3/expat-2.8.3.tar.xz
  tree a0d7940a8f80f4c4fef377d7c56d2d4a4228132fe09b678009abf9e68b33024b
}

build() {
  auto-config LDFLAGS=-Wl,--as-needed,-lunwind
  make install DESTDIR=/dst
  rm -f -r /dst/lib/cmake
}
