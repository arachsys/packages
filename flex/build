require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.6.5 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.6.5/flex-2.6.5.tar.gz
  apply gettext.diff
  tree 9f557553af1d565dec6e514437ba3e1b28dfd27f64a32494eb79190fec28a5b1
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
