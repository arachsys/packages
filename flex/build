require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.6.16 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.6.16/flex-2.6.16.tar.gz
  tree bd578dda314a113bfe6b14f350b6b226bf731409372a2823caad2d4efc562471
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
