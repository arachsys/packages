require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.7.6 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.7.6/flex-2.7.6.tar.gz
  tree 3a4438e3e7681c33002db2fb543352f561f8cd8428fee6771cb0130c56997746
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
