require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.6.17 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.6.17/flex-2.6.17.tar.gz
  tree 7958192e4776568bf085bb75e3f9f113c9a7f422e4dd4d9f0c1166fc59128fd1
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
