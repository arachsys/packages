require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.7.9 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.7.9/flex-2.7.9.tar.gz
  tree b5c7f2f925ae2677db86085dbcec5e502c26392ce7af3290015cc074d3a0224b
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
