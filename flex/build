require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.7.4 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.7.4/flex-2.7.4.tar.gz
  tree 15d56c06706cd1829bb7b9b8e1209c5cda0f5a9a106482d85485d2157417c8ae
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
