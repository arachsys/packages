require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.7.1 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.7.1/flex-2.7.1.tar.gz
  tree 3aa1deb86e8df0c61d1ffbcbb60e91e395a576436e6749f24ddb6c168733c3b0
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
