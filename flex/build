require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.7.2 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.7.2/flex-2.7.2.tar.gz
  tree aeedab2b15a72fcedbe5a6e80204953b28342e2d8eddfe9b80548539170868dc
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
