require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.6.9 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.6.9/flex-2.6.9.tar.gz
  tree 83700171f97b49eee8629ee864c7400bc290ec9e2fe7e093b9ba6929b9a7809e
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
