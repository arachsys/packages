require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.6.8 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.6.8/flex-2.6.8.tar.gz
  tree 0ed038795c28904cdc73e1f1ffb2a841d1879efdaaa238a9160e1f2ed620897f
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
