require m4

check() {
  url https://github.com/westes/flex/tags
  match version 2.6.13 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/westes/flex/releases/download/v2.6.13/flex-2.6.13.tar.gz
  tree e3232efae14095555ce92ce8c80211d8684f217c50fb4673933ef8822f52607e
}

build() {
  auto-config --disable-shared
  make install DESTDIR=/dst
  image - requires m4
}
