require go

check() {
  url https://github.com/junegunn/fzf/tags
  match version 0.74.3 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack fzf-0.74.3.tar.gz \
    https://github.com/junegunn/fzf/archive/refs/tags/v0.74.3.tar.gz
  go mod vendor
  tree 0519b4d090ae7d6aa9e7540e13b28f9c28270bc54fd0c6c55802bddf7e684e92
}

build() {
  go build -ldflags "-s -w -X main.version=0.74.3 -X main.revision=arachsys"
  install -D fzf /dst/bin/fzf
}
