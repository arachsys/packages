require go

check() {
  url https://github.com/junegunn/fzf/tags
  match version 0.75.0 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack fzf-0.75.0.tar.gz \
    https://github.com/junegunn/fzf/archive/refs/tags/v0.75.0.tar.gz
  go mod vendor
  tree e7b8abe05d2a478b5e35293020d8e7958422be077c5ae1d70e44f2f853500fb9
}

build() {
  go build -ldflags "-s -w -X main.version=0.75.0 -X main.revision=arachsys"
  install -D fzf /dst/bin/fzf
}
