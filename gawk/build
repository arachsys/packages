check() {
  url https://{,mirrorservice.org/sites/}ftp.gnu.org/gnu/gawk/
  match version 5.4.2 'gawk-([0-9.]+)\.tar'
}

prepare() {
  unpack https://ftp.gnu.org/gnu/gawk/gawk-5.4.2.tar.xz
  tree a37ec5ed7722dc36a1a40d279964c4adaf4f27b3e063ab2f560e73b59131d20f
}

build() {
  auto-config
  make install DESTDIR=/dst
  rm -f /dst/bin/gawk{-*,bug}
}
