check() {
  url https://{,mirrorservice.org/sites/}ftp.gnu.org/gnu/gzip/
  match version 1.15 'gzip-([0-9.]+)\.tar'
}

prepare() {
  unpack https://ftp.gnu.org/gnu/gzip/gzip-1.15.tar.xz
  tree 451ff78d2992f80251b5345bda86845ca5a81d20d89555cf6fa86b1c008f8dfe
}

build() {
  auto-config
  make install DESTDIR=/dst
  rm -f /dst/bin/z{cmp,diff,force,*grep,less,more,new} \
    /dst/lib/man/man1/z{cmp,diff,force,*grep,less,more,new}.1 \
    /dst/bin/{gzexe,uncompress} /dst/lib/man/man1/{gzexe,uncompress}.1
}
