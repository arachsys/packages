require libnl-tiny

check() {
  url https://w1.fi/releases/
  match version 2.12 'hostapd-([0-9.]+)\.tar'
}

prepare() {
  unpack https://w1.fi/releases/hostapd-2.12.tar.gz
  apply libnl.diff
  apply tidy.diff
  tree 31bd88370c987c360a6c2c8e65b17823894433e17edd8492175f7d13b7604c9e
}

build() {
  cp /pkg/config hostapd/.config
  make -C hostapd hostapd PKG_CONFIG=false
  install -s -D hostapd/hostapd /dst/bin/hostapd
}
