require rust

check() {
  url https://github.com/cloud-hypervisor/cloud-hypervisor/tags
  match version 54.0 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack cloud-hypervisor-54.0.tar.xz \
    https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v54.0/cloud-hypervisor-v54.0.tar.xz
  apply cosmetic.diff
  apply rawimg.diff
  apply tapip.diff
  tree 79c274ab319f1b77a5610dd98c234589a76c821fece11f90077bb51e1d51733e
}

build() {
  cargo build --bin=cloud-hypervisor --release
  install -s -D target/release/cloud-hypervisor /dst/bin/hypervisor
}
