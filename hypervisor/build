require rust

check() {
  url https://github.com/cloud-hypervisor/cloud-hypervisor/tags
  match version 54.1 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack cloud-hypervisor-54.1.tar.xz \
    https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v54.1/cloud-hypervisor-v54.1.tar.xz
  apply cosmetic.diff
  apply rawimg.diff
  apply tapip.diff
  tree e5cdf2636eb2dfad97dcd5b39919bdbb441c9bebda61b703e73d77af42f01e50
}

build() {
  cargo build --bin=cloud-hypervisor --release
  install -s -D target/release/cloud-hypervisor /dst/bin/hypervisor
}
