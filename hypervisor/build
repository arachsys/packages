require rust

check() {
  url https://github.com/cloud-hypervisor/cloud-hypervisor/tags
  match version 55.0 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack cloud-hypervisor-55.0.tar.xz \
    https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v55.0/cloud-hypervisor-v55.0.tar.xz
  apply cosmetic.diff
  apply rawimg.diff
  tree 33175987d95611e7febbc2a0417630ee6295884e2d19d5b901244f40a02644f1
}

build() {
  cargo build --bin=cloud-hypervisor --release
  install -s -D target/release/cloud-hypervisor /dst/bin/hypervisor
}
