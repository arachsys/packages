require bison flex

check() {
  url https://www.kernel.org/pub/linux/utils/net/iproute2/
  match version 7.2.0 'iproute2-([0-9.]+)\.tar'
}

prepare() {
  unpack https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-7.2.0.tar.xz
  apply nocompat.diff
  apply paths.diff
  apply unspec.diff
  tree 0bb05bd35cc239c446c591f23527d8adf52d0a8f9fe597e5c20132734ac67b8c
}

build() {
  CC=cc PKG_CONFIG=/bin/false /src/configure --prefix= --color=auto
  make install CC=cc DESTDIR=/dst
  sed -e 's/#.*//' -e 's/[[:blank:]]\+/ /g' -e 's/^ //' -e 's/ $//' \
      -e '/^$/d' -i /dst/lib/{iproute2,tc}/*
  rm -f -r /dst/bin/{ifcfg,routef,routel,rtpr} /dst/lib/bash-completion
}
