require bison flex

check() {
  url https://www.kernel.org/pub/linux/utils/net/iproute2/
  match version 7.3.0 'iproute2-([0-9.]+)\.tar'
}

prepare() {
  unpack https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-7.3.0.tar.xz
  apply nocompat.diff
  apply paths.diff
  apply unspec.diff
  tree b120076faefdbb5b1d2a4051ee2860f2a4c8d715d8328c18bf9a30d0f7b0c6f8
}

build() {
  CC=cc PKG_CONFIG=/bin/false /src/configure --prefix= --color=auto
  make install CC=cc DESTDIR=/dst
  sed -e 's/#.*//' -e 's/[[:blank:]]\+/ /g' -e 's/^ //' -e 's/ $//' \
      -e '/^$/d' -i /dst/lib/{iproute2,tc}/*
  rm -f -r /dst/bin/{ifcfg,routef,routel,rtpr} /dst/lib/bash-completion
}
