check() {
  url https://github.com/mawww/kakoune/tags
  match version 2026.05.21 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack kakoune-2026.09.06.tar.gz \
    https://github.com/mawww/kakoune/archive/1235028d.tar.gz
  apply atomic.diff
  apply finaleol.diff
  apply getenv.diff
  apply init.diff
  apply news.diff
  apply palette.diff
  apply paths.diff
  apply perl.diff
  apply stdin.diff
  apply tabs.diff
  apply windowing.diff
  find -xtype l -delete
  tree 50d8fbdd3b35c18763ae0679f636f5eb4db797ea63e0bb9d871da143dbb2256d
}

build() {
  if enabled static; then
    if [[ $(c++ --version) == *clang* ]]; then
      LIBS='LDFLAGS+=-static LIBS+=-lunwind LIBS+=-lc++abi'
    else
      LIBS='LDFLAGS+=-static'
    fi
  fi

  make install DESTDIR=/dst PREFIX= version=2026.05.21 $LIBS
  find /dst/lib/kak/{colors,kakrc,rc} -type f | while read FILE; do
    sed -E -e 's/rgb:[[:xdigit:]]{2}{3,4}/\L&/g' -e '/^\s*#/d' \
        -e "s/^(([^'\"#]*|'[^']*'|\"([^\"\\]|\\\\.)*\")*)\\s+#\\s.*/\\1/" \
        -e 's/\s+$//' -e '/./,/^$/p' -n "$FILE" | sed '${/^$/d}' \
      | expand -i > "$FILE.tmp" && mv -f "$FILE.tmp" "$FILE"
  done
  rm -f /dst/lib/kak/rc/{*/*.pl,tools/{git,man,patch}.kak}
}
