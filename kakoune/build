check() {
  url https://github.com/mawww/kakoune/tags
  match version 2026.05.21 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack kakoune-2026.09.15.tar.gz \
    https://github.com/mawww/kakoune/archive/f16dba30.tar.gz
  apply finaleol.diff
  apply getenv.diff
  apply init.diff
  apply news.diff
  apply palette.diff
  apply paths.diff
  apply perl.diff
  apply stdin.diff
  apply tabs.diff
  apply windowing.diff
  find -xtype l -delete
  tree a1cd682d61c47967f65b5c4e806dfe56467edf5a985aa69b26f4b78ae241e6df
}

build() {
  if enabled static; then
    if [[ $(c++ --version) == *clang* ]]; then
      LIBS='LDFLAGS+=-static LIBS+=-lunwind LIBS+=-lc++abi'
    else
      LIBS='LDFLAGS+=-static'
    fi
  fi

  make install DESTDIR=/dst PREFIX= version=2026.09.15 $LIBS
  find /dst/lib/kak/{colors,kakrc,rc} -type f | while read FILE; do
    sed -E -e 's/rgb:[[:xdigit:]]{2}{3,4}/\L&/g' -e '/^\s*#/d' \
        -e "s/^(([^'\"#]*|'[^']*'|\"([^\"\\]|\\\\.)*\")*)\\s+#\\s.*/\\1/" \
        -e 's/\s+$//' -e '/./,/^$/p' -n "$FILE" | sed '${/^$/d}' \
      | expand -i > "$FILE.tmp" && mv -f "$FILE.tmp" "$FILE"
  done
  rm -f /dst/lib/kak/rc/{*/*.pl,tools/{git,man,patch}.kak}
}
