check() {
  url https://github.com/libarchive/libarchive/tags
  match version 3.8.10 'v([0-9.]+)\.tar'
}

prepare() {
  unpack libarchive-3.8.10.tar.xz \
    https://github.com/libarchive/libarchive/releases/download/v3.8.10/libarchive-3.8.10.tar.xz
  apply cosmetic.diff
  tree 4b366ed83a3a92ab030aef3c2fc7601f4690570959f4a028f2023dde5929ea4b
}

build() {
  auto-config --disable-acl --enable-bsd{cat,cpio,tar}=dynamic \
    --enable-xattr --without-{expat,xml2} --with-{bz2lib,lzma,zlib,zstd}
  make install DESTDIR=/dst
  mv /dst/bin/{bsdcpio,cpio}
  mv /dst/bin/{bsdtar,tar}
}
