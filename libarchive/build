check() {
  url https://github.com/libarchive/libarchive/tags
  match version 3.8.9 'v([0-9.]+)\.tar'
}

prepare() {
  unpack libarchive-3.8.9.tar.xz \
    https://github.com/libarchive/libarchive/releases/download/v3.8.9/libarchive-3.8.9.tar.xz
  apply cosmetic.diff
  tree fadba46a454708fdd5bf4b7da478a5d82497112d8c85c00a528db82664adac1e
}

build() {
  auto-config --disable-acl --enable-bsd{cat,cpio,tar}=dynamic \
    --enable-xattr --without-{expat,xml2} --with-{bz2lib,lzma,zlib,zstd}
  make install DESTDIR=/dst
  mv /dst/bin/{bsdcpio,cpio}
  mv /dst/bin/{bsdtar,tar}
}
