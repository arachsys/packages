check() {
  url https://github.com/libarchive/libarchive/tags
  match version 3.8.11 'v([0-9.]+)\.tar'
}

prepare() {
  unpack libarchive-3.8.11.tar.xz \
    https://github.com/libarchive/libarchive/releases/download/v3.8.11/libarchive-3.8.11.tar.xz
  apply cosmetic.diff
  tree 6cdc015d018f8b773ed0f056c7e8b227518eab79ec08ecf5c7602a9319b074b0
}

build() {
  auto-config --disable-acl --enable-bsd{cat,cpio,tar}=dynamic \
    --enable-xattr --without-{expat,xml2} --with-{bz2lib,lzma,zlib,zstd}
  make install DESTDIR=/dst
  mv /dst/bin/{bsdcpio,cpio}
  mv /dst/bin/{bsdtar,tar}
}
