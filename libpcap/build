require bison flex libnl-tiny

check() {
  url https://www.tcpdump.org/release/
  match version 1.10.7 'libpcap-([0-9.]+)\.tar'
}

prepare() {
  unpack https://www.tcpdump.org/release/libpcap-1.10.7.tar.gz
  apply libnl.diff
  tree 302ced11bef7f571429423618f4cfbec10c7b649f223bff731392edbe1975d25
}

build() {
  auto-config --with-libnl --with-pcap=linux
  sed -i 's/-lnl-tiny/-l:libnl-tiny.a/g' **/Makefile
  make install DESTDIR=/dst
  rm -f /dst/bin/pcap-config
}
