require bison flex libnl-tiny

check() {
  url https://www.tcpdump.org/release/
  match version 1.11.0 'libpcap-([0-9.]+)\.tar'
}

prepare() {
  unpack https://www.tcpdump.org/release/libpcap-1.11.0.tar.gz
  apply libnl.diff
  tree e30ae9f2464a484094beab69fe82522ff69ae0bb31c8668357feb4b7cf611016
}

build() {
  auto-config --with-libnl --with-pcap=linux
  sed -i 's/-lnl-tiny/-l:libnl-tiny.a/g' **/Makefile
  make install DESTDIR=/dst
  rm -f /dst/bin/pcap-config
}
