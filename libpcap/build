require bison flex libnl-tiny

check() {
  url https://www.tcpdump.org/release/
  match version 1.11.1 'libpcap-([0-9.]+)\.tar'
}

prepare() {
  unpack https://www.tcpdump.org/release/libpcap-1.11.1.tar.gz
  apply libnl.diff
  tree ac921e83b9bd257c6ffce2edc7f48766ea4d73b39f0aef98af3ba45fa0eb82fd
}

build() {
  auto-config --with-libnl --with-pcap=linux
  sed -i 's/-lnl-tiny/-l:libnl-tiny.a/g' **/Makefile
  make install DESTDIR=/dst
  rm -f /dst/bin/pcap-config
}
