check() {
  url https://github.com/LMDB/lmdb/tags
  match version 1.0.2 'LMDB_([0-9.]+)\.tar'
}

prepare() {
  unpack -p 3 lmdb-1.0.2.tar.gz \
    https://github.com/LMDB/lmdb/archive/refs/tags/LMDB_1.0.2.tar.gz
  tree d5f01e14834887bcb55dcac5693e4bdabbbc723950c288013939e803564a54dc
}

build() {
  make CC=cc all
  mkdir -p /dst/lib/{include,shared,static}
  cp lmdb.h /dst/lib/include/lmdb.h
  cp liblmdb.a /dst/lib/static/liblmdb.a
  cp -P liblmdb.so liblmdb.so.* /dst/lib/shared
}
