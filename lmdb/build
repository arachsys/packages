check() {
  url https://github.com/LMDB/lmdb/tags
  match version 1.0.1 'LMDB_([0-9.]+)\.tar'
}

prepare() {
  unpack -p 3 lmdb-1.0.1.tar.gz \
    https://github.com/LMDB/lmdb/archive/refs/tags/LMDB_1.0.1.tar.gz
  tree cb5cca04ef6edeb63d5c5f532af6ba967e8de0359d0a8d3b0ca235f1cfdf432d
}

build() {
  make CC=cc all
  mkdir -p /dst/lib/{include,shared,static}
  cp lmdb.h /dst/lib/include/lmdb.h
  cp liblmdb.a /dst/lib/static/liblmdb.a
  cp -P liblmdb.so liblmdb.so.* /dst/lib/shared
}
