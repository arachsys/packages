check() {
  url https://www.lua.org/ftp/
  match version 5.5.1 'lua-([0-9.]+)\.tar'
}

prepare() {
  unpack https://www.lua.org/ftp/lua-5.5.1.tar.gz
  apply paths.diff
  tree 97d13effa02177f45a50840fb7943d05edac3ac354b9685781a089402f9a9026
}

build() {
  make linux CC=cc MYCFLAGS=-fPIC
  make install INSTALL_TOP=/dst
}
