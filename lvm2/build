check() {
  url https://sourceware.org/ftp/lvm2/
  match version 2.03.44 'LVM2\.([0-9.]+)\.tgz'

  url https://codeberg.org/jmoyer/libaio/releases
  match libaio 0.3.113 'libaio-([0-9.]+)\.tar'
}

prepare() {
  unpack lvm2-2.03.44.tar.gz https://sourceware.org/ftp/lvm2/LVM2.2.03.44.tgz
  unpack -d aio \
    https://codeberg.org/jmoyer/libaio/releases/download/libaio-0.3.113/libaio-0.3.113.tar.gz
  apply basename.diff
  apply pkgconfig.diff
  apply static.diff
  apply stdio.diff
  apply tidy.diff
  tree 6393683192004c3237a259b39a30360fa3fc8bc6b6cba700a9574a7ccafc3fd2
}

build() {
  make -C /src/aio/src libaio.a
  auto-config --enable-dmfilemapd --without-{cache,symvers,thin,vdo} \
    --with-libexecdir=/lib/lvm2 AIO_LIBS=/src/aio/src/libaio.a \
    CPPFLAGS=-I/src/aio/src PKG_CONFIG=false
  sed -i 's:/lib/lvm2/lvresize_fs_helper:/lib/lvm2/lvresize-fs-helper:' \
    include/configure.h
  make install DESTDIR=/dst
  rm -f /dst/bin/{blkdeactivate,fsadm,lvm_import_vdo,lvmdump,lvmpersist}
  rm -f -r /dst/lib
  find /dst/bin -type l -delete
}
