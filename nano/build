check() {
  url https://ftp.gnu.org{,.uk}/gnu/nano/
  match version 9.2 'nano-([0-9.]+)\.tar'
}

prepare() {
  unpack https://ftp.gnu.org/gnu/nano/nano-9.2.tar.xz
  tree 43cebd606496ad99817e5f47d82a81b8e161756d2866f763107103d90e6e824f
}

build() {
  auto-config
  make install DESTDIR=/dst
  rm -f /dst/bin/rnano
}
