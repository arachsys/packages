check() {
  url https://{,mirrorservice.org/sites/}ftp.gnu.org/gnu/patch/
  match version 2.8.1 'patch-([0-9.]+)\.tar'
}

prepare() {
  unpack https://ftp.gnu.org/gnu/patch/patch-2.8.1.tar.xz
  tree 0218da143b511986d80c5078c90fb194f7aedc0bc15f23e1aa63ec7f82a2253e
}

build() {
  auto-config
  make install DESTDIR=/dst
  rm -f /dst/lib/charset.alias
}
