check() {
  url https://github.com/pcre2project/pcre2/tags
  match version 10.49 'tags/pcre2-([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/pcre2project/pcre2/releases/download/pcre2-10.49/pcre2-10.49.tar.gz
  tree 53c9d6a19fbea2ee3800a515496f8bfa46349c71faf655dc2297d08e1775f84e
}

build() {
  auto-config --enable-jit
  make install DESTDIR=/dst
  rm -f -r /dst/bin
}
