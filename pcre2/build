check() {
  url https://github.com/pcre2project/pcre2/tags
  match version 10.48 'tags/pcre2-([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/pcre2project/pcre2/releases/download/pcre2-10.48/pcre2-10.48.tar.gz
  tree b9e2f49dd4231fb62d13b1e7565c6fc08ce094322ceed01085ff3fd20cb0c0de
}

build() {
  auto-config --enable-jit
  make install DESTDIR=/dst
  rm -f -r /dst/bin
}
