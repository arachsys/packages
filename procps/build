check() {
  url https://sourceforge.net/projects/procps-ng/files/Production/
  match version 4.0.7 'procps-ng-([0-9.]+)\.tar'
}

prepare() {
  unpack https://downloads.sourceforge.net/project/procps-ng/Production/procps-ng-4.0.7.tar.xz
  apply cosmetic.diff
  apply pidns.diff
  tree 1a8cd9d750035ec8dc4c7d7da7b3e93dfe8baaa1b3d525105457098a2fbaee62
}

build() {
  auto-config --disable-{kill,modern-top,shared} --enable-watch8bit \
    NCURSES_CFLAGS= NCURSES_LIBS=-lncursesw PKG_CONFIG=/bin/true
  make install DESTDIR=/dst
  rm -f -r /dst/bin/w /dst/lib/{include,lib*.a,man/man1/w.1,pkgconfig}
}
