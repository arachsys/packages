check() {
  url https://{,mirrorservice.org/sites/}ftp.gnu.org/gnu/readline/
  match version 8.3 'readline-([0-9.]+)\.tar\.gz'
}

prepare() {
  unpack https://ftp.gnu.org/gnu/readline/readline-8.3.tar.gz
  apply config.diff
  apply rpath.diff
  apply upstream.diff
  tree d79f86b69be8b729802c8338543a1b8cdca5e384610e7632127526eea837dc70
}

build() {
  auto-config --disable-install-examples
  make install DESTDIR=/dst SHLIB_LIBS=-lncurses
}
