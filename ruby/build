require libffi
[[ $CHOST == @(aarch64|amd64|x86_64)* ]] && require rust

check() {
  url https://www.ruby-lang.org/en/downloads/
  match version 4.0.10 'ruby-([0-9.]+)\.tar'

  url https://github.com/yaml/libyaml/tags
  match libyaml 0.2.6 'tags/([0-9.]+)\.tar'
}

prepare() {
  unpack https://cache.ruby-lang.org/pub/ruby/4.0/ruby-4.0.10.tar.gz
  unpack -d libyaml \
    https://github.com/yaml/libyaml/releases/download/0.2.6/yaml-0.2.6.tar.gz
  apply irb.diff
  apply paths.diff
  apply plain.diff
  tree 9343496e047e4917a5cd9880bd3418a982a5e7debfdd72f7c6dd6d9da1c9606d
}

build() {
  auto-config --disable-install-doc  --disable-rpath --enable-shared \
    --with-libyaml-source-dir=/src/libyaml --with-ridir=/lib/ruby/doc \
    --with-ruby{arch,}hdrdir=/lib/include \
    --with-ruby{arch,lib}prefix=/lib/ruby \
    --with-{site,vendor}{archdir,archhdrdir,dir,hdrdir}=no \
    $([[ $CHOST == @(aarch64|amd64|x86_64)* ]] && echo LIBS=-lunwind)
  make install DESTDIR=/dst
  rm -f /dst/bin/{bundle,bundler,minitest,syntax_suggest,test-unit,typeprof}
  rm -f /dst/bin/*.lock /dst/lib/include/rb_mjit_min_header-*.h
  image - requires libffi
}
