enable setuid setgid

check() {
  url https://github.com/shadow-maint/shadow/tags
  match version 4.20.3 'tags/([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/shadow-maint/shadow/releases/download/4.20.3/shadow-4.20.3.tar.xz
  apply backups.diff
  apply defaults.diff
  apply nss.diff
  apply paths.diff
  tree 6017d68d0360dbf11f726b4b519c3d60e677700aee0bd629608fc90c41cf5209
}

build() {
  PKG_CONFIG=/bin/true auto-config --disable-logind --disable-shared \
    --with-bcrypt --without-{audit,btrfs,libbsd,libpam,sssd}
  sed -e 's:^\(#define FAILLOG_FILE\).*:\1 "/dev/null":' \
      -e 's:^\(#define LASTLOG_FILE\).*:\1 "/dev/null":' \
      -e 's:^\(#define _UTMP_FILE\).*:\1 "/dev/null":' \
      -e 's:^\(#define _WTMP_FILE\).*:\1 "/dev/null":' \
      -i config.h
  make install DESTDIR=/dst
  chgrp shadow /dst/bin/chage
  chmod u-s,g+s /dst/bin/chage
  rm -f /dst/bin/{chfn,faillog,groups,lastlog,logoutd}
  rm -f /dst/lib/man/man*/{chfn,faillog,groups,lastlog,logoutd}.*
  rm -f -r /dst/lib/include /dst/lib/*.a
}
