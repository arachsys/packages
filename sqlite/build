check() {
  url https://www.sqlite.org/index.html
  match version 3.53.4 'Version ([0-9.]*[0-9])'
}

prepare() {
  unpack sqlite-3.53.4.tar.gz \
    https://www.sqlite.org/2026/sqlite-autoconf-3530400.tar.gz
  tree 931dbcc04a171e04dee15560f0193cfce0a8d72560f06ea886e72510e0d7732f
}

build() {
  /src/configure --prefix= --all --disable-static-shell
  make install DESTDIR=/dst LDFLAGS.rpath= datadir='${prefix}/lib' \
    includedir='${prefix}/lib/include'
}
