check() {
  url https://www.sqlite.org/index.html
  match version 3.54.0 'Version ([0-9.]*[0-9])'
}

prepare() {
  unpack sqlite-3.54.0.tar.gz \
    https://www.sqlite.org/2026/sqlite-autoconf-3540000.tar.gz
  tree d595f1238548032f3be6719a3751fdb5f0dbd6c3b9f78482d1758c865c0f0ada
}

build() {
  /src/configure --prefix= --all --disable-static-shell
  make install DESTDIR=/dst LDFLAGS.rpath= datadir='${prefix}/lib' \
    includedir='${prefix}/lib/include'
}
