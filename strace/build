check() {
  url https://github.com/strace/strace/tags
  match version 7.2 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://strace.io/files/7.2/strace-7.2.tar.xz
  tree 9fa8bde0b77be4fa63026b569a3df5592e7550a091b5a965c6f1e524d4d12ec0
}

build() {
  auto-config --disable-gcc-Werror --disable-mpers
  make install DESTDIR=/dst
  rm -f /dst/bin/strace-{graph,log-merge}
}
