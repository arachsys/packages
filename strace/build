check() {
  url https://github.com/strace/strace/tags
  match version 7.3 'tags/v([0-9.]+)\.tar'
}

prepare() {
  unpack https://strace.io/files/7.3/strace-7.3.tar.xz
  tree 4dc4822ba1eaa221c6b1e330d3f456f3ddefffe68951ecfe1e4e938fb6c250b9
}

build() {
  auto-config --disable-gcc-Werror --disable-mpers
  make install DESTDIR=/dst
  rm -f /dst/bin/strace-{graph,log-merge}
}
