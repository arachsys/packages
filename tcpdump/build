require libpcap

check() {
  url https://www.tcpdump.org/release/
  match version 4.99.7 'tcpdump-([0-9.]+)\.tar'
}

prepare() {
  unpack https://www.tcpdump.org/release/tcpdump-4.99.7.tar.gz
  tree 93707a2941a48ff212995f0dc6c6a41aeb78d6abcbac0770d6150addffeccba1
}

build() {
  auto-config
  make install DESTDIR=/dst
  rm -f /dst/bin/tcpdump.*
  image - requires libpcap
}
