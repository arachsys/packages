require bison libevent

check() {
  url https://github.com/tmux/tmux/tags
  match version 3.8 'tags/([0-9.]+[a-z]?)\.tar'
}

prepare() {
  unpack https://github.com/tmux/tmux/releases/download/3.8/tmux-3.8.tar.gz
  tree 49103aed0747ac10e00cb5aded7f53c323e79a2db98216fee4888cd36a3238b8
}

build() {
  auto-config
  sed -i 's/-l\(event[^ ]*\)/-l:lib\1.a/g' Makefile
  make install DESTDIR=/dst
}
