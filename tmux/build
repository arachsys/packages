require bison libevent

check() {
  url https://github.com/tmux/tmux/tags
  match version 3.7c 'tags/([0-9.]+[a-z]?)\.tar'
}

prepare() {
  unpack https://github.com/tmux/tmux/releases/download/3.7c/tmux-3.7c.tar.gz
  tree 74e51baf7b473e235cf6cb969ae7c001d1f88603c34385e588f36489df1cee18
}

build() {
  auto-config
  sed -i 's/-l\(event[^ ]*\)/-l:lib\1.a/g' Makefile
  make install DESTDIR=/dst
}
