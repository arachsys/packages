require libevent

check() {
  url https://dist.torproject.org/
  match version 0.4.9.16 'tor-([0-9.]+)\.tar'
}

prepare() {
  unpack https://dist.torproject.org/tor-0.4.9.16.tar.gz
  apply cosmetic.diff
  apply config.diff
  tree 9cd6bcaade7f4fa94a5c0f9919b725bf9dc738ccee1337780e4c4ae6de6ab721
}

build() {
  auto-config --enable-lzma --enable-zstd CONFDIR=/etc \
    CPPFLAGS=-DDISABLE_ENGINES {LZMA,ZSTD}_CFLAGS=-I/lib/include \
    LZMA_LIBS=-llzma ZSTD_LIBS=-lzstd
  sed -i 's/-levent/-l:libevent.a/g' Makefile
  make install DESTDIR=/dst
  rm -f /dst/bin/torify
}
