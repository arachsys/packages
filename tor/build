require libevent

check() {
  url https://dist.torproject.org/
  match version 0.4.9.12 'tor-([0-9.]+)\.tar'
}

prepare() {
  unpack https://dist.torproject.org/tor-0.4.9.12.tar.gz
  apply cosmetic.diff
  apply config.diff
  tree d9e6fcf4b366521c5663cbc9c31b4094858ddadbeeeb48ab00cf3a00272cc913
}

build() {
  auto-config --enable-lzma --enable-zstd CONFDIR=/etc \
    CPPFLAGS=-DDISABLE_ENGINES {LZMA,ZSTD}_CFLAGS=-I/lib/include \
    LZMA_LIBS=-llzma ZSTD_LIBS=-lzstd
  sed -i 's/-levent/-l:libevent.a/g' Makefile
  make install DESTDIR=/dst
  rm -f /dst/bin/torify
}
