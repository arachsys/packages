require libevent

check() {
  url https://dist.torproject.org/
  match version 0.4.9.14 'tor-([0-9.]+)\.tar'
}

prepare() {
  unpack https://dist.torproject.org/tor-0.4.9.14.tar.gz
  apply cosmetic.diff
  apply config.diff
  tree c0d740aaa8cbe53f38a3bc7bdc96143797ea15cff50f4e862524b579392be0d9
}

build() {
  auto-config --enable-lzma --enable-zstd CONFDIR=/etc \
    CPPFLAGS=-DDISABLE_ENGINES {LZMA,ZSTD}_CFLAGS=-I/lib/include \
    LZMA_LIBS=-llzma ZSTD_LIBS=-lzstd
  sed -i 's/-levent/-l:libevent.a/g' Makefile
  make install DESTDIR=/dst
  rm -f /dst/bin/torify
}
