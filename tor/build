require libevent

check() {
  url https://dist.torproject.org/
  match version 0.4.9.17 'tor-([0-9.]+)\.tar'
}

prepare() {
  unpack https://dist.torproject.org/tor-0.4.9.17.tar.gz
  apply cosmetic.diff
  apply config.diff
  tree decc8e70d4cc98ee80a93569ad449ebad2f04d31d79ed59f4fa1f47de2816941
}

build() {
  auto-config --enable-lzma --enable-zstd CONFDIR=/etc \
    CPPFLAGS=-DDISABLE_ENGINES {LZMA,ZSTD}_CFLAGS=-I/lib/include \
    LZMA_LIBS=-llzma ZSTD_LIBS=-lzstd
  sed -i 's/-levent/-l:libevent.a/g' Makefile
  make install DESTDIR=/dst
  rm -f /dst/bin/torify
}
