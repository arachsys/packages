require libevent

check() {
  url https://dist.torproject.org/
  match version 0.4.9.13 'tor-([0-9.]+)\.tar'
}

prepare() {
  unpack https://dist.torproject.org/tor-0.4.9.13.tar.gz
  apply cosmetic.diff
  apply config.diff
  tree a3e932a00da3e8430bca240f83be05c5ab8c85d6a6cf1e091c0f0f87a5c85a8f
}

build() {
  auto-config --enable-lzma --enable-zstd CONFDIR=/etc \
    CPPFLAGS=-DDISABLE_ENGINES {LZMA,ZSTD}_CFLAGS=-I/lib/include \
    LZMA_LIBS=-llzma ZSTD_LIBS=-lzstd
  sed -i 's/-levent/-l:libevent.a/g' Makefile
  make install DESTDIR=/dst
  rm -f /dst/bin/torify
}
