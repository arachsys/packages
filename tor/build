require libevent

check() {
  url https://dist.torproject.org/
  match version 0.4.9.15 'tor-([0-9.]+)\.tar'
}

prepare() {
  unpack https://dist.torproject.org/tor-0.4.9.15.tar.gz
  apply cosmetic.diff
  apply config.diff
  tree 6e2891ebdf232997bd981bc1e846cbe80332d6a64aa8a62a0c6a6d8a18b21e3d
}

build() {
  auto-config --enable-lzma --enable-zstd CONFDIR=/etc \
    CPPFLAGS=-DDISABLE_ENGINES {LZMA,ZSTD}_CFLAGS=-I/lib/include \
    LZMA_LIBS=-llzma ZSTD_LIBS=-lzstd
  sed -i 's/-levent/-l:libevent.a/g' Makefile
  make install DESTDIR=/dst
  rm -f /dst/bin/torify
}
