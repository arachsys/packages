enable setuid

check() {
  url https://api.github.com/repos/arachsys/arachsys-utils/branches/master
  match snapshot 20260812 \
    '"date": *"([0-9]{4})-([0-9]{2})-([0-9]{2})' '\1\2\3'
}

prepare() {
  unpack arachsys-utils-20260812-32f4e10b.tar.gz \
    https://github.com/arachsys/arachsys-utils/archive/32f4e10b.tar.gz
  tree 80bd51a24df209c00944de620b82820a2d87a87a043a00fc009c0328a29985f6
}

build() {
  make -C host install DESTDIR=/img/host-utils
  make -C user install DESTDIR=/img/user-utils
}
