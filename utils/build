enable setuid

check() {
  url https://api.github.com/repos/arachsys/arachsys-utils/branches/master
  match snapshot 20261122 \
    '"date": *"([0-9]{4})-([0-9]{2})-([0-9]{2})' '\1\2\3'
}

prepare() {
  unpack arachsys-utils-20261122-7a1f2891.tar.gz \
    https://github.com/arachsys/arachsys-utils/archive/7a1f2891.tar.gz
  tree b205a018e3fb485d5e4003b3d616995f9e7ac5a059f1ea4568efb802b57415e3
}

build() {
  make -C host install DESTDIR=/img/host-utils
  make -C user install DESTDIR=/img/user-utils
}
