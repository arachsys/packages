check() {
  url https://github.com/vim/vim/tags
  match version '9.2.09??' 'v([0-9.]+)\.tar'
}

prepare() {
  unpack vim-9.2.0901.tar.gz \
    https://github.com/vim/vim/archive/refs/tags/v9.2.0901.tar.gz
  apply paths.diff
  tree d526e881d3f85faf2115402a8ff006694ac191d9b154b61e74e72dced2e9b837
}

build() {
  auto-config --enable-{multibyte,terminal} --without-local-dir
  make install DESTDIR=/dst VIMRTLOC=/lib/vim
  ln -s vim /dst/bin/vi
  rm -r /dst/bin/vimtutor /dst/lib/{applications,icons} \
    /dst/lib/vim/{**/README.*,*_example.vim,tools}
}
