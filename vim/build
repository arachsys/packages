check() {
  url https://github.com/vim/vim/tags
  match version '9.2.14??' 'v([0-9.]+)\.tar'
}

prepare() {
  unpack vim-9.2.1406.tar.gz \
    https://github.com/vim/vim/archive/refs/tags/v9.2.1406.tar.gz
  apply paths.diff
  tree 45875d07913bf9f4a797e20b9329beb0f0e61f115c75f8bc7309fc43b0c4c8ca
}

build() {
  auto-config --enable-{multibyte,terminal} --without-local-dir
  make install DESTDIR=/dst VIMRTLOC=/lib/vim
  ln -s vim /dst/bin/vi
  rm -r /dst/bin/vimtutor /dst/lib/{applications,icons} \
    /dst/lib/vim/{**/README.*,*_example.vim,tools}
}
