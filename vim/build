check() {
  url https://github.com/vim/vim/tags
  match version '9.2.10??' 'v([0-9.]+)\.tar'
}

prepare() {
  unpack vim-9.2.1001.tar.gz \
    https://github.com/vim/vim/archive/refs/tags/v9.2.1001.tar.gz
  apply paths.diff
  tree 33bad5da64ce92bdb250911a0ad463961c0376fbc67dcce57bba0e851a5ff811
}

build() {
  auto-config --enable-{multibyte,terminal} --without-local-dir
  make install DESTDIR=/dst VIMRTLOC=/lib/vim
  ln -s vim /dst/bin/vi
  rm -r /dst/bin/vimtutor /dst/lib/{applications,icons} \
    /dst/lib/vim/{**/README.*,*_example.vim,tools}
}
