check() {
  url https://github.com/vim/vim/tags
  match version '9.2.13??' 'v([0-9.]+)\.tar'
}

prepare() {
  unpack vim-9.2.1302.tar.gz \
    https://github.com/vim/vim/archive/refs/tags/v9.2.1302.tar.gz
  apply paths.diff
  tree ec1bc7b30535c3a7d65d133f634d7da71aa57c897002fd22a3060f8140f68d72
}

build() {
  auto-config --enable-{multibyte,terminal} --without-local-dir
  make install DESTDIR=/dst VIMRTLOC=/lib/vim
  ln -s vim /dst/bin/vi
  rm -r /dst/bin/vimtutor /dst/lib/{applications,icons} \
    /dst/lib/vim/{**/README.*,*_example.vim,tools}
}
