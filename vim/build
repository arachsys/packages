check() {
  url https://github.com/vim/vim/tags
  match version '9.2.11??' 'v([0-9.]+)\.tar'
}

prepare() {
  unpack vim-9.2.1107.tar.gz \
    https://github.com/vim/vim/archive/refs/tags/v9.2.1107.tar.gz
  apply paths.diff
  tree b53b5ca150552e9ccda042826ac69a9c0970506e47a116b8c218c6476d2cfe0c
}

build() {
  auto-config --enable-{multibyte,terminal} --without-local-dir
  make install DESTDIR=/dst VIMRTLOC=/lib/vim
  ln -s vim /dst/bin/vi
  rm -r /dst/bin/vimtutor /dst/lib/{applications,icons} \
    /dst/lib/vim/{**/README.*,*_example.vim,tools}
}
