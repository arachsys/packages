check() {
  url https://github.com/vim/vim/tags
  match version '9.2.12??' 'v([0-9.]+)\.tar'
}

prepare() {
  unpack vim-9.2.1202.tar.gz \
    https://github.com/vim/vim/archive/refs/tags/v9.2.1202.tar.gz
  apply paths.diff
  tree d2b1e98d15ac257374859c967095c9b60db5bfc1998cb6e5ea0ee500ed2c9f84
}

build() {
  auto-config --enable-{multibyte,terminal} --without-local-dir
  make install DESTDIR=/dst VIMRTLOC=/lib/vim
  ln -s vim /dst/bin/vi
  rm -r /dst/bin/vimtutor /dst/lib/{applications,icons} \
    /dst/lib/vim/{**/README.*,*_example.vim,tools}
}
