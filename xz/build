check() {
  url https://github.com/tukaani-project/xz/tags
  match version 5.8.4 'v([0-9.]+)\.tar'
}

prepare() {
  unpack https://github.com/tukaani-project/xz/releases/download/v5.8.4/xz-5.8.4.tar.xz
  tree 9fc5c2e4ac0051ed46f866d14bd23fe7cfeac0d26215a58e94f9cdfdc5083f24
}

build() {
  auto-config
  make install DESTDIR=/dst
  rm -f /dst/bin/{lz,xz}{cmp,diff,*grep,less,more} \
    /dst/lib/man/man1/{lz,xz}{cmp,diff,*grep,less,more}.1
}
